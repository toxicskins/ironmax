generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TxType {
  DEPOSIT
  BET
  WIN
  ADMIN_ADJUST
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  role           Role     @default(USER)
  firstName      String?
  lastName       String?
  billingAddress String?
  createdAt      DateTime @default(now())

  wallet       Wallet?
  transactions Transaction[]
  bets         Bet[]
  invoices     Invoice[]
  resetTokens  PasswordResetToken[]
  minesRounds  MinesRound[]
  blackjackRounds BlackjackRound[]
  towerRounds  TowerRound[]
  hiLoRounds   HiLoRound[]
  baccaratRounds BaccaratRound[]
  holdemRounds HoldemRound[]
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  coins       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  type           TxType
  status         TxStatus   @default(COMPLETED)
  coinsDelta     Int
  eurAmount      Decimal?   @db.Decimal(10, 2)
  paynetOrderId  String?    @unique
  note           String?
  createdAt      DateTime   @default(now())

  // Billing snapshot captured at checkout time (DepositForm) — kept on the transaction rather
  // than only on User, since a buyer's name/address at the time of a given purchase shouldn't
  // silently change if they later edit their profile.
  billingName    String?
  billingPhone   String?
  billingAddress String?

  invoice        Invoice?
}

model Invoice {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  number        String      @unique
  // ponytail: PDF bytes stored directly in Postgres instead of S3 — invoices are small and this
  // avoids a second AWS service to wire up. Move to S3 if invoice volume/size ever gets heavy.
  pdfData       Bytes
  createdAt     DateTime    @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Singleton row (id always "singleton") holding the outbound-mail connection the admin panel
// configures — password-reset and order-confirmation emails read this instead of env vars, so
// it can be changed from the UI without a redeploy.
model MailSettings {
  id        String   @id @default("singleton")
  smtpHost  String?
  smtpPort  Int?
  smtpUser  String?
  smtpPass  String?
  fromEmail String?
  fromName  String?
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Bet {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  gameKey      String
  stake        Int
  payout       Int
  serverSeed   String
  clientSeed   String
  nonce        BigInt
  resultJson   String
  createdAt    DateTime @default(now())
}

// A live, multi-step Mines round: the mine layout is generated once at start and kept
// server-side (never sent to the client) so a player can pick tiles one at a time and cash out
// whenever they choose, without being able to read ahead. Every other game resolves instantly
// in one request; Mines is the one that needs state to live between requests.
model MinesRound {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  stake      Int
  mineCount  Int
  grid       String // JSON bool[25], true = mine — never sent to the client while active
  revealed   String   @default("[]") // JSON number[] of safely-revealed tile indices, in order
  status     String   @default("active") // active | cashed | busted
  serverSeed String
  clientSeed String
  nonce      BigInt
  createdAt  DateTime @default(now())
}

// A live blackjack hand: the shuffled deck is generated once at start and kept server-side
// (only drawn cards are ever sent to the client) so Hit/Stand/Double can be separate requests
// without the client being able to read ahead in the deck.
model BlackjackRound {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  stake       Int
  deck        String // JSON string[52], shuffled once at start — never sent to the client
  drawIndex   Int      @default(4) // next undealt index into `deck`; 4 cards already dealt at start
  playerCards String // JSON string[] — hand A (the only hand, unless split)
  dealerCards String // JSON string[]
  doubled     Boolean  @default(false)
  // Split support: splitCards is hand B, dealt only after Split. Hand A is played out first
  // (activeHand 0); once it stands/busts, activeHand flips to 1 and hand B is played; once both
  // are done the dealer plays out once and both hands settle against the same dealer total.
  splitCards  String? // JSON string[] — hand B, null unless split
  activeHand  Int      @default(0) // 0 = playing hand A, 1 = playing hand B
  handADone   Boolean  @default(false)
  handABust   Boolean  @default(false)
  status      String   @default("active") // active | finished
  serverSeed  String
  clientSeed  String
  nonce       BigInt
  createdAt   DateTime @default(now())
}

// A live Tower Climb run: one bomb layout per floor is generated once at start and kept
// server-side (never sent to the client) so a player can pick one tile per floor and cash out
// whenever they choose, exactly like Mines but row-by-row instead of one flat grid.
model TowerRound {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  stake       Int
  tilesPerRow Int
  safeTiles   Int // how many of tilesPerRow are safe, per floor
  rows        Int      @default(8)
  layout      String // JSON number[rows][safeTiles] — the safe tile index(es) per floor
  climbed     String   @default("[]") // JSON number[] tile index picked per floor climbed so far
  status      String   @default("active") // active | busted | cashed
  serverSeed  String
  clientSeed  String
  nonce       BigInt
  createdAt   DateTime @default(now())
}

// A live Hi-Lo round: the current card is drawn and shown at start, before the player commits
// to higher/lower — the guess has to be a real choice made after seeing the card, not baked
// into the same request that reveals it.
model HiLoRound {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  stake       Int
  currentCard String
  status      String   @default("active") // active | finished
  serverSeed  String
  clientSeed  String
  nonce       BigInt
  createdAt   DateTime @default(now())
}

// A live Baccarat round: Player's 2 cards are dealt and shown at start, Banker's 2 are dealt at
// the same time but kept hidden server-side — the bet has to be placed on real (if partial)
// information, not after the whole table is already face up.
model BaccaratRound {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  stake        Int
  deck         String // JSON string[52], shuffled once at start — never sent to the client
  playerCards  String // JSON string[2] — shown to the client immediately
  bankerCards  String // JSON string[2] — dealt now, hidden from the client until pick
  status       String   @default("active") // active | finished
  serverSeed   String
  clientSeed   String
  nonce        BigInt
  createdAt    DateTime @default(now())
}

// A live heads-up Texas Hold'em hand against the house bot: both hole hands and the full
// board are dealt from one shuffled deck at start and kept server-side (the bot's hand and
// un-revealed community cards are never sent to the client) — betting then proceeds street by
// street across separate requests, exactly like a real hand.
model HoldemRound {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  stake            Int // the bet/raise increment for this hand
  deck             String // JSON string[52]: [0,1]=player hole, [2,3]=bot hole, [4-6]=flop, [7]=turn, [8]=river
  street           String   @default("preflop") // preflop | flop | turn | river | finished
  revealedCount    Int      @default(0) // how many of the 5 community cards are currently revealed
  pot              Int      @default(0)
  playerCommitted  Int      @default(0)
  botCommitted     Int      @default(0)
  toCall           Int      @default(0) // what the player currently owes; 0 = check/bet is their free action
  raisesThisStreet Int      @default(0)
  status           String   @default("active") // active | finished
  serverSeed       String
  clientSeed       String
  nonce            BigInt
  createdAt        DateTime @default(now())
}
